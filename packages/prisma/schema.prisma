generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // Needed for pgvector
  output          = "../../node_modules/.prisma/client"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "./generated/zod"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String   @id
  name     String
  email    String   @unique
  joinedAt DateTime @default(now())
}

model Workspace {
  id        String   @id
  name      String
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
